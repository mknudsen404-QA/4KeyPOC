# ESP-IDF build/work output — regenerated by idf.py, not source
build/
work/
sdkconfig.old
managed_components/

# Vendored ESP-IDF components fetched by the component manager — refetchable
# from dependencies.lock via `idf.py reconfigure`, not worth tracking here.
components/

# Python bridge: venv and cache are per-machine, not source
host/.venv/
host/__pycache__/
host/tests/__pycache__/
.pytest_cache/

# Personal/local bridge state — agents.example.json is the checked-in
# template; agent_registry.json and agents.json are generated/personal.
host/agent_registry.json
host/agent_registry.json.lock
host/agent_registry.json.ui_token
host/agents.json

.DS_Store

# KiCad generator bytecode
hardware/kicad/tools/__pycache__/
__pycache__/
